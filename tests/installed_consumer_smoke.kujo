test_setup { from src.ollama import create_client, parse_stream; from src.provider import ollama_provider; from src.ai_sdk import sdk_contract_version }
test "installed public exports and transitive AI SDK resolve" {
	client := create_client({"host": "http://localhost:11434"})
	assert_equal(client["host"], "http://localhost:11434")
	assert_equal(ollama_provider({"model": "fixture"})["driver"]["id"], "ollama-native")
	assert_equal(sdk_contract_version(), "1.0.0")
	parsed := parse_stream(["{\"message\":{\"content\":\"installed\"},\"done\":true}\n"], "")
	assert_true(parsed["ok"]); assert_equal(parsed["events"][0]["message"]["content"], "installed")
}
