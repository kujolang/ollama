# Descriptor and semantic hooks for Kujo AI SDK provider-driver 1.0.0.
func get(obj, key, fallback) { if type(obj) == "dict" && has_key(obj, key) { return obj[key] }; return fallback }
func provider_impl(config) {
	if type(config) != "dict" { config := {} }; host := get(config, "host", "http://localhost:11434")
	return {"name": "ollama", "base_url": host, "chat_path": "/api/chat", "embeddings_path": "/api/embed", "api_key_env": "OLLAMA_API_KEY", "default_model": get(config, "model", ""), "allow_insecure_localhost": true, "capabilities": {"streaming": true, "tool_calls": true, "json_mode": true, "embeddings": true}, "driver": driver()}
}
func describe(provider) { return {"id": "ollama-native", "protocol": "ollama-api", "auth": {"mode": "optional-bearer", "allow_anonymous": true}, "capabilities": provider["capabilities"]} }
func validate(provider) { if type(provider) != "dict" || get(provider, "base_url", "") == "" { return {"ok": false, "errors": [{"field": "base_url", "message": "Ollama provider requires a host."}] } }; return {"ok": true, "errors": []} }
func encode_messages(messages) { result := []; for message in messages { item := {"role": get(message, "role", "user"), "content": get(message, "content", "")}; if has_key(message, "name") { item["name"] := message["name"] }; if has_key(message, "tool_calls") { item["tool_calls"] := message["tool_calls"] }; result := push(result, item) }; return result }
func encode_chat(context) { options := context["resolved_options"]; payload := {"model": get(options, "model", get(context["provider"], "default_model", "")), "messages": context["messages"], "stream": get(options, "stream", false)}; for key in ["tools", "format", "think", "options", "keep_alive", "logprobs", "top_logprobs"] { if has_key(options, key) { payload[key] := options[key] } }; return {"url": context["provider"]["base_url"] + "/api/chat", "method": "POST", "headers": {"Content-Type": "application/json"}, "protected_headers": ["Content-Type"], "body": to_json(payload), "stream_mode": payload["stream"]} }
func usage(data) { input := get(data, "prompt_eval_count", 0); output := get(data, "eval_count", 0); return {"input_tokens": input, "output_tokens": output, "total_tokens": input + output} }
func decode_chat(context) { data := context["data"]; message := get(data, "message", {}); input := get(data, "prompt_eval_count", 0); output := get(data, "eval_count", 0); return {"ok": true, "request_id": "", "model": get(data, "model", context["fallback_model"]), "output_text": get(message, "content", ""), "finish_reason": get(data, "done_reason", "stop"), "tool_calls": get(message, "tool_calls", []), "usage": {"input_tokens": input, "output_tokens": output, "total_tokens": input + output}, "raw_provider": data} }
func decode_error(context) { data := context["data"]; if type(data) != "dict" || !has_key(data, "error") { return {"ok": false, "matched": false} }; return {"ok": false, "matched": true, "category": "provider", "message": get(data, "error", "Ollama error"), "provider_code": "ollama_error", "raw_provider": data} }
func parse_stream(chunks, body) { combined := ""; if type(chunks) == "array" { for c in chunks { combined = combined + c } } else { combined = body }; events := []; for line in split(combined, "\n") { if trim(line) == "" { continue }; frame := null; try { frame = parse_json(trim(line)) } except err { return {"ok": false} }; events = concat(events, [frame]) }; return {"ok": true, "events": events} }
func decode_stream(context) { combined := ""; chunks := get(context, "chunks", null); if type(chunks) == "array" { for c in chunks { combined = combined + c } } else { combined = get(context, "body_text", "") }; text := ""; last := {}; for line in split(combined, "\n") { if trim(line) == "" { continue }; frame := null; try { frame = parse_json(trim(line)) } except err { return {"ok": false} }; last = frame; text = text + get(get(frame, "message", {}), "content", "") }; input := get(last, "prompt_eval_count", 0); output := get(last, "eval_count", 0); return {"ok": true, "request_id": "", "model": get(last, "model", context["fallback_model"]), "output_text": text, "finish_reason": get(last, "done_reason", "stop"), "tool_calls": get(get(last, "message", {}), "tool_calls", []), "usage": {"input_tokens": input, "output_tokens": output, "total_tokens": input + output}, "raw_provider": {"native_stream": true}} }
func encode_embeddings(context) { return {"url": context["provider"]["base_url"] + "/api/embed", "method": "POST", "headers": {"Content-Type": "application/json"}, "protected_headers": ["Content-Type"], "body": to_json({"model": context["resolved_options"]["model"], "input": context["input"]}), "stream_mode": false} }
func decode_embeddings(context) { data := context["data"]; values := []; index := 0; for vector in get(data, "embeddings", []) { values := push(values, {"index": index, "vector": vector}); index := index + 1 }; return {"ok": true, "model": get(data, "model", context["fallback_model"]), "embeddings": values, "usage": {"input_tokens": 0, "total_tokens": 0}, "raw_provider": data} }
func driver() { return {"contract": "ai-sdk-provider-driver", "version": "1.0.0", "id": "ollama-native", "describe": describe, "validate": validate, "encode_chat": encode_chat, "decode_chat": decode_chat, "decode_error": decode_error, "decode_stream": decode_stream, "encode_embeddings": encode_embeddings, "decode_embeddings": decode_embeddings} }
export ollama_provider := provider_impl
export ollama_driver := driver
export encode_messages := encode_messages
export parse_stream := parse_stream
export ollama_openai_compatible_provider := func(config) { if type(config) != "dict" { config := {} }; host := get(config, "host", "http://localhost:11434"); return {"name": "ollama-openai-compatible", "base_url": host + "/v1", "chat_path": "/chat/completions", "api_key_env": "OLLAMA_API_KEY", "default_model": get(config, "model", ""), "allow_insecure_localhost": true, "capabilities": {"streaming": true, "tool_calls": true, "json_mode": true, "embeddings": true}} }
